<?xml version="1.0" encoding="utf-8"?>
<!-- This is the layout for the Splash Screen -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">
    <!-- Green background, nature theme -->

    <!-- This is the app title text in the centre of the screen -->
    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Campsite Commander"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"/>

    <!-- This is the subtitle below the title -->
    <TextView
        android:id="@+id/tvSplashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSplashTitle"
        android:layout_centerHorizontal="true"
        android:text="Your Gear. Your Adventure."
        android:textColor="#A5D6A7"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

</RelativeLayout>