<?xml version="1.0" encoding="utf-8"?>
<!-- This is the layout for the Detailed View Screen -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20"
    android:padding="16dp">

    <!-- Title at the top of the screen -->
    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Gear List"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <!-- ScrollView lets the user scroll through the list -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDetailTitle"
        android:layout_above="@id/btnBack"
        android:layout_marginTop="16dp">

        <!-- This TextView displays all the gear details -->
        <TextView
            android:id="@+id/tvGearList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>

    </ScrollView>

    <!-- Back to Base button at the bottom -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:text="Back to Base"
        android:backgroundTint="#388E3C"/>

</RelativeLayout>