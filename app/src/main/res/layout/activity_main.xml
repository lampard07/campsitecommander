<?xml version="1.0" encoding="utf-8"?>
<!-- This is the layout for the Main Screen -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20"
    android:padding="16dp">

    <!-- App title at the top -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:text="Campsite Commander"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <!-- Shows the total number of items packed -->
    <TextView
        android:id="@+id/tvTotalItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Total Items Packed: 0"
        android:textColor="#A5D6A7"
        android:textSize="18sp"/>

    <!-- Button to add new gear -->
    <Button
        android:id="@+id/btnAddGear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTotalItems"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="Add Gear"
        android:backgroundTint="#4CAF50"/>

    <!-- Button to view the full gear list -->
    <Button
        android:id="@+id/btnViewGear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnAddGear"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="View Gear List"
        android:backgroundTint="#388E3C"/>

</RelativeLayout>